# Example environment variables for local development and for the deploy provider.
# Copy this file to `.env` locally and fill in real values. Do NOT commit real secrets.

# ── ML Assistant (LLM) ─────────────────────────────────────────────────────
# Powers the 🤖 Agent chat panel via Claude Haiku (api/chat.cjs).
# Get a key at https://console.anthropic.com
# Leave unset to fall back to the built-in rule-based assistant.
ANTHROPIC_API_KEY=

# Public base path (if you deploy to GitHub Pages or a subpath)
VITE_PUBLIC_BASE_PATH=/

# Optional: local dev server port
PORT=5173

# Database configuration
# Path where the SQLite database will be stored (relative to api directory)
DB_PATH=./api/questions.db

# Environment (development/production)
NODE_ENV=development
